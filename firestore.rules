rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwnerEmail() {
      return isVerified() && request.auth.token.email == 'xxliamlimey@gmail.com';
    }

    function isStaffMember() {
      return isVerified() && (
        isOwnerEmail() ||
        exists(/databases/$(database)/documents/staff/$(request.auth.uid))
      );
    }

    // Application Marketplace
    match /apps/{appId} {
      // Anyone can view published applications; staff can view all (drafts included)
      allow get: if resource.data.status == 'published' || isStaffMember();
      allow list: if resource.data.status == 'published' || isStaffMember();
      
      // Only authorized staff can create, update, or delete applications
      allow create: if isStaffMember();
      allow update: if isStaffMember();
      allow delete: if isStaffMember();
    }

    // Categories and Tags
    match /tags/{tagId} {
      allow read: if true;
      allow write: if isStaffMember();
    }

    // Global Website Settings
    match /settings/{configId} {
      allow read: if true;
      allow write: if isStaffMember();
    }

    // Staff Management - STRICTLY OWNER ONLY (xxliamlimey@gmail.com)
    match /staff/{staffId} {
      allow read, write: if isOwnerEmail();
    }
  }
}
